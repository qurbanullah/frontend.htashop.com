# Copy to .env.production (for production builds) or .env.development (for local dev).

# API base URL (Laravel backend)
VITE_API_URL=https://api.htashop.com/api/v1

# Canonical site origin — must match the backend FRONTEND_URL
VITE_SITE_URL=https://htashop.com
VITE_SITE_NAME=HTAShop

# Media CDN origin used to resolve stored asset keys (avatars, banners, images)
VITE_CDN_URL=https://cdn.htashop.com

# Optional 1200×630 social share card (CDN key or absolute URL) used as the
# fallback og:image. Leave blank to omit og:image on pages without an image.
VITE_DEFAULT_OG_IMAGE=

# Cloudflare Turnstile (CAPTCHA)
# - Required for login/registration in production.
# - Use a "always passes" test key (1x00000000000000000000AA) for local testing if
#   you want the real widget; otherwise leave Turnstile bypassed (see below).
VITE_TURNSTILE_SITE_KEY=

# Set to "true" to fully bypass Turnstile (e.g. local/CI). Bypass is automatic
# when running `vite dev`, so this is only needed for production builds run locally.
VITE_TURNSTILE_DISABLED=false

# Error monitoring (optional — Sentry loads only after analytics consent)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Deployment environment label (used by Sentry)
VITE_APP_ENV=production

# Analytics / marketing (optional — loaded only after consent)
VITE_GA4_ID=
VITE_META_PIXEL_ID=
